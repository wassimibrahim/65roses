# TERRA OS — environment
# Copy to .env.local (or .env) and fill in. The MVP runs with no paid API keys.

# ── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://terra:terra@127.0.0.1:5432/terra_os?schema=public"

# ── AUTH ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3100"

# ── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Terra OS"
# Renders the "Illustrative Demo Data" discipline throughout the UI.
NEXT_PUBLIC_DEMO_MODE="true"

# ── MAP (optional) ───────────────────────────────────────────────────────────
# Without a token the origination heatmap falls back to a list + schematic view.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ── INTELLIGENCE (optional, off by default) ──────────────────────────────────
# "none" keeps Terra Intelligence fully deterministic and local.
# Confidential data is never sent to an external model unless this is
# explicitly configured. See src/lib/providers/llm.ts.
LLM_PROVIDER="none"
ANTHROPIC_API_KEY=""
