# 65 ROSES — environment
# Copy to .env and fill in. Console providers need no keys.
# 0065

# ── DATABASE ────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/roses65"

# ── AUTH ────────────────────────────────────────────────────
# Auth.js session encryption secret. Generate: openssl rand -base64 32
AUTH_SECRET=""
# Canonical URL of the deployment (used for callbacks and links in messages).
AUTH_URL="http://localhost:3000"

# ── CRYPTO ──────────────────────────────────────────────────
# AES-256-GCM key for field encryption (phone, addressLine). 32 bytes, base64.
# Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=""
# Server pepper for HMAC-SHA256 hashing of OTP and door codes.
# Generate: openssl rand -base64 32
CODE_HASH_PEPPER=""

# ── ADMIN ───────────────────────────────────────────────────
# Comma-separated email allowlist for /atelier, on top of the role check.
ATELIER_ALLOWLIST=""

# ── SMS (Phase 0+: OTP, invitations, door codes, venue reveal) ──
# "console" (dev/test) or "twilio"
SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Sender: a phone number or alphanumeric ID, per Twilio setup.
TWILIO_FROM=""

# ── EMAIL (Phase 1+: application received, approval, resets) ──
# "console" (dev/test) or "resend"
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
# From address for all transactional mail.
EMAIL_FROM="65 <no-reply@example.com>"

# ── PAYMENTS (Phase 2+: Stem payment; Phase 5: subscriptions, Whish) ──
# "console" (dev/test), "stripe", or "whish"
PAYMENT_PROVIDER="console"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Webhook signing secret — the webhook is the only place a payment becomes PAID.
STRIPE_WEBHOOK_SECRET=""
# Whish (Lebanon) — Phase 5.
WHISH_API_KEY=""
WHISH_WEBHOOK_SECRET=""

# ── COMMUNITY (Phase 4: /rose/circle) ───────────────────────
# WhatsApp invite links; admin-rotatable. May be superseded by a settings table.
COMMUNITY_LINK_ANNOUNCEMENTS=""
COMMUNITY_LINK_ROSES=""

# ── JOBS (Phase 3: door codes, venue reveal, post-event messages) ──
# Shared secret protecting cron/job endpoints from public invocation.
CRON_SECRET=""

# ── PUBLIC ──────────────────────────────────────────────────
# Public origin used to build /s/<token> links shown to members.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
